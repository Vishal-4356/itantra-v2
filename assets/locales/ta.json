{
  "lang_id": 2,
  "lang_code": "ta",
  "lang_name": "தமிழ் (Tamil)",
  "intents": {
    "0": "மருத்துவ அவசரநிலை: உடனடி உதவி தேவை",
    "1": "தீ விபத்து: உடனடியாக வெளியேறவும்",
    "2": "எதிரி அச்சுறுத்தல் கண்டறியப்பட்டது: பாதுகாப்பு எடுக்கவும்",
    "3": "தேடுதல் மற்றும் மீட்பு: எனது இடத்தில் குழு தேவை",
    "4": "பாதுகாப்பு மீறல்: கூடுதல் படை கோரப்படுகிறது",
    "5": "கட்டிட இழிவு: சிக்கிய நபர்கள் கண்டறியப்பட்டனர்",
    "6": "வெடிமருந்து குறைவு: மறுவழங்கல் தேவை",
    "7": "தொடர்பு சரிபார்ப்பு: அனைத்து நிலையங்களும் நிலையை தெரிவிக்கவும்",
    "8": "பணி முடிந்தது: தளத்திற்கு திரும்புகிறோம்",
    "9": "அதி அவசர அழைப்பு: அனைத்து பிரிவுகளும் பதிலளிக்கவும்",
    "10": "பாதை தடைபட்டது: மாற்றுப்பாதை தேவை",
    "11": "காயமடைந்தோர் வெளியேற்றம் கோரப்படுகிறது",
    "12": "பகுதி பாதுகாப்பானது",
    "13": "காத்திருக்கவும்: கட்டளைக்காக காத்திருங்கள்",
    "14": "முதன்மை மீட்பு புள்ளியில் சந்திக்கவும்",
    "15": "அபாயகரமான ரசாயன வாயு கண்டறியப்பட்டது"
  }
}
