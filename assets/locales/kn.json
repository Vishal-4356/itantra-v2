{
  "lang_id": 5,
  "lang_code": "kn",
  "lang_name": "ಕನ್ನಡ (Kannada)",
  "intents": {
    "0": "ವೈದ್ಯಕೀಯ ತುರ್ತು ಪರಿಸ್ಥಿತಿ: ತಕ್ಷಣದ ನೆರವು ಬೇಕು",
    "1": "ಬೆಂಕಿ ಅವಘಡ: ತಕ್ಷಣವೇ ಖಾಲಿ ಮಾಡಿ",
    "2": "ಶತ್ರು ಬೆದರಿಕೆ ಪತ್ತೆಯಾಗಿದೆ: ಸುರಕ್ಷಿತ ಸ್ಥಳಕ್ಕೆ ತೆರಳಿ",
    "3": "ಹುಡುಕಾಟ ಮತ್ತು ಪಾರುಗಾಣಿಕಾ: ತಂಡದ ಅಗತ್ಯವಿದೆ",
    "4": "ಭದ್ರತಾ ಉಲ್ಲಂಘನೆ: ಹೆಚ್ಚುವರಿ ಪಡೆಗಳ ವಿನಂತಿ",
    "5": "ಕಟ್ಟಡ ಕುಸಿತ: ಸಿಲುಕಿರುವ ಜನರು ಪತ್ತೆಯಾಗಿದ್ದಾರೆ",
    "6": "ಮದ್ದುಗುಂಡುಗಳ ಕೊರತೆ: ಮರುಪೂರೈಕೆ ಅಗತ್ಯವಿದೆ",
    "7": "ಸಂವಹನ ಪರಿಶೀಲನೆ: ಸ್ಥಿತಿ ವರದಿ ನೀಡಿ",
    "8": "ಕಾರ್ಯಾಚರಣೆ ಪೂರ್ಣಗೊಂಡಿದೆ: ನೆಲೆಗೆ ಮರಳುತ್ತಿದ್ದೇವೆ",
    "9": "ತುರ್ತು ಎಚ್ಚರಿಕೆ: ಎಲ್ಲಾ ಪಡೆಗಳು ಪ್ರತಿಕ್ರಿಯಿಸಿ",
    "10": "ಮಾರ್ಗ ನಿರ್ಬಂಧಿಸಲಾಗಿದೆ: ಪರ್ಯಾಯ ಮಾರ್ಗ ಬೇಕು",
    "11": "ಗಾಯಾಳುಗಳ ಸ್ಥಳಾಂತರಕ್ಕೆ ವಿನಂತಿ",
    "12": "ಪ್ರದೇಶ ಸುರಕ್ಷಿತವಾಗಿದೆ",
    "13": "ಕಾಯಿರಿ: ಸೂಚನೆಗಳಿಗಾಗಿ ಕಾಯಿರಿ",
    "14": "ಮುಖ್ಯ ಬಿಂದುವಿನಲ್ಲಿ ಭೇಟಿಯಾಗಿ",
    "15": "ಅಪಾಯಕಾರಿ ರಾಸಾಯನಿಕ ಅನಿಲ ಪತ್ತೆಯಾಗಿದೆ"
  }
}
