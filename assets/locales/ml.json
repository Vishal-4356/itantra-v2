  "lang_name": "മലയാളം (Malayalam)",
  "intents": {
    "0": "വൈദ്യ അടിയന്തരാവസ്ഥ: അടിയന്തര സഹായം ആവശ്യമാണ്",
    "1": "തീപിടുത്തം: ഉടൻ ഒഴിഞ്ഞുപോകുക",
    "2": "ശത്രു ഭീഷണി കണ്ടെത്തി: സുരക്ഷിത സ്ഥാനം എടുക്കുക",
    "3": "തിരച്ചിലും രക്ഷാപ്രവർത്തനവും: സംഘം ആവശ്യമാണ്",
    "4": "സുരക്ഷാ വീഴ്ച: അധിക സേന ആവശ്യമാണ്",
    "5": "കെട്ടിട തകർച്ച: കുടുങ്ങിയ ആളുകളെ കണ്ടെത്തി",
    "6": "വെടിക്കോപ്പുകൾ കുറവ്: പുനഃവിതരണം ആവശ്യമാണ്",
    "7": "ആശയവിനിമയ പരിശോധന: നില അറിയിക്കുക",
    "8": "ദൗത്യം പൂർത്തിയായി: തിരിച്ചെത്തുന്നു",
    "9": "അടിയന്തര സന്ദേശം: എല്ലാ യൂണിറ്റുകളും മറുപടി നൽകുക",
    "10": "വഴി തടസ്സപ്പെട്ടു: മറ്റൊരു വഴി ആവശ്യമാണ്",
    "11": "പരിക്കേറ്റവരെ മാറ്റൽ ആവശ്യപ്പെടുന്നു",
    "12": "മേഖല സുരക്ഷിതമാണ്",
    "13": "കാത്തിരിക്കുക: നിർദ്ദേശങ്ങൾക്കായി കാത്തിരിക്കുക",
    "14": "പ്രാഥമിക കേന്ദ്രത്തിൽ ഒത്തുചേരുക",
    "15": "അപകടകരമായ രാസവാതകം കണ്ടെത്തി"
  }
}
